#!/bin/bash
# Pick any wormhole project, switch to it via wormhole (opening it if needed),
# and go to one of its tide views (files, search, git, home), as the tide key
# bindings do from inside the project, but fresh: with the editor popped and the
# files query cleared. Exits non-zero if no project is chosen.
#
# `f-tide recent` instead picks from files recently opened in the editor, across
# all projects, and opens the chosen one in the editor in its project's files view.
# Files not under a project wormhole is tracking are not offered.
#
# `f-tide copy-path` instead picks a project wormhole is tracking and copies its
# directory to the clipboard, without switching to it.

view="$1"

RECENT_FILES="$HOME/.config/micro/recent-files"

main() {
    local project window options=(--fresh)
    if [ "$view" = copy-path ]; then
        local path
        IFS=$'\t' read -r _ path < <(tracked_projects | fzf --delimiter '\t' --with-nth 1)
        [ -n "$path" ] || exit 1
        (cd "$path" && printf %s "$(pwd)" | pbcopy)
        return
    elif [ "$view" = recent ]; then
        local file
        IFS=$'\t' read -r project _ file < <(recent_files | fzf --no-sort --delimiter '\t' --with-nth 1,2)
        [ -n "$file" ] || exit 1
        view=files
        options=(--open "$file")
    else
        project="$(projects | fzf)"
        [ -n "$project" ] || exit 1
    fi
    # Switch project via wormhole first so that the project's window, not the
    # window the popup was opened from, is tmux's last window when the view
    # window closes.
    wormhole open --project "$project" --land-in terminal || exit
    window="$(project_window "$project")"
    tmux run-shell -b -t "$window" \
        "$HOME/.local/bin/tide $(tmux_shell_words "${options[@]}") $view '#{window_name}' '#{@project}' '#{@view}' '#{pane_current_path}' '#{session_name}'"
}

# The projects and tasks wormhole is tracking, in wormhole's most-recent-first
# ring order with the current project moved last, then every other repo it
# could open.
projects() {
    wormhole project list --output json |
        jq -r '(.current | .[1:] + .[:1] | .[].project_key), .available[]' |
        awk '!seen[$0]++'
}

# `<project>\t<path>` for each project wormhole is tracking, in the order that
# `projects` lists them.
tracked_projects() {
    wormhole project list --output json |
        jq -r '.current | .[1:] + .[:1] | .[] | "\(.project_key)\t\(.path)"'
}

# `<project>\t<path relative to project>\t<absolute path>` for each existing
# file in the editors' open log, most recent first, assigned to the tracked project
# with the longest matching directory.
recent_files() {
    awk '{ lines[NR] = $0 } END { for (i = NR; i > 0; i--) if (!seen[lines[i]]++) print lines[i] }' "$RECENT_FILES" |
        grep -v '/\.git/' |
        while IFS= read -r file; do [ -f "$file" ] && printf '%s\n' "$file"; done |
        awk -F '\t' '
            NR == FNR { dirs[$1] = $2; next }
            {
                best = ""
                for (dir in dirs)
                    if (index($0, dir "/") == 1 && length(dir) > length(best)) best = dir
                if (best != "") printf "%s\t%s\t%s\n", dirs[best], substr($0, length(best) + 2), $0
            }' <(wormhole project list --output json | jq -r '.current[] | "\(.path)\t\(.project_key)"') -
}

# A project's own window is the one carrying no @view. Target it by window id:
# project names contain ':', which tmux would parse as session:window.
project_window() {
    tmux list-windows -a -F '#{window_id}' \
        -f "#{&&:#{==:#{@project},$1},#{==:#{@view},}}"
}

# Words single-quoted for the shell that run-shell starts, with `#` doubled so
# that tmux does not expand it as a format.
tmux_shell_words() {
    local word quoted=()
    for word in "$@"; do
        word="'${word//\'/\'\\\'\'}'"
        quoted+=("${word//#/##}")
    done
    printf '%s' "${quoted[*]}"
}

main
